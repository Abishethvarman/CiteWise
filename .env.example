# Copy to .env in the repository root or in backend/. Do not commit .env.

CITEWISE_DATA_DIR=./data
CITEWISE_DATABASE_URL=sqlite:///./data/citewise.db
CITEWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CITEWISE_OLLAMA_BASE_URL=http://127.0.0.1:11434
CITEWISE_OLLAMA_MODEL=llama3.2:3b
# auto uses sentence-transformers when that extra is installed, then Ollama embeddings, then hashing.
CITEWISE_EMBEDDING_BACKEND=auto
CITEWISE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CITEWISE_OLLAMA_EMBED_MODEL=nomic-embed-text
CITEWISE_CHUNK_SIZE=700
CITEWISE_CHUNK_OVERLAP=100
CITEWISE_TOP_K=4
CITEWISE_BM25_WEIGHT=0.45
CITEWISE_SEMANTIC_WEIGHT=0.55
CITEWISE_SCORE_THRESHOLD=0.2
CITEWISE_MAX_UPLOAD_MB=25
CITEWISE_MAX_PAGES=200
CITEWISE_LLM_TIMEOUT_SECONDS=120
CITEWISE_LOG_LEVEL=INFO

# Frontend, used by Vite. Leave the repository URL empty until you publish one.
VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_REPOSITORY_URL=
